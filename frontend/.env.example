# Salin file ini menjadi .env lalu sesuaikan nilainya

# Base URL API Backend
# Dev: '/api' -> di-proxy Vite ke http://localhost:8000 (lihat vite.config.js)
# Prod: isi URL lengkap, contoh: https://api.example.com/api
VITE_API_URL=/api

# Realtime (Laravel Reverb / Pusher) - opsional
VITE_PUSHER_APP_KEY=monkey
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_SCHEME=http
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=8080
